# Copy to .env.docker (ignored by Git), then supply UNIQUE, RANDOM secrets.
# Never deploy with empty/placeholder passwords. Never commit .env.docker.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sara
MYSQL_USER=sara_app
MYSQL_PASSWORD=
JWT_SECRET=
OTP_PEPPER=

# This profile is for local Docker verification, NOT a production security profile.
NODE_ENV=development
NOTIFICATION_PROVIDER=mock
CORS_ALLOWED_ORIGINS=
SARA_API_PORT=3000

# Only set if using real email OTP with a verified sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional: absolute path outside Git repo, used only with compose.fcm.yaml.
FCM_SERVICE_ACCOUNT_PATH=

LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
